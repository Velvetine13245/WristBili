<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="back"><text class="back-text">‹</text></div>
      <text class="title">热搜榜</text>
    </div>
    <text class="status">{{status}}</text>

    <div class="hot-card" onclick="openHot1"><text class="rank-gold">1</text><text class="hot-title-gold">{{h1}}</text></div>
    <div class="hot-card" onclick="openHot2"><text class="rank-silver">2</text><text class="hot-title-silver">{{h2}}</text></div>
    <div class="hot-card" onclick="openHot3"><text class="rank-bronze">3</text><text class="hot-title-bronze">{{h3}}</text></div>
    <div class="hot-card" onclick="openHot4"><text class="rank">4</text><text class="hot-title">{{h4}}</text></div>
    <div class="hot-card" onclick="openHot5"><text class="rank">5</text><text class="hot-title">{{h5}}</text></div>
    <div class="hot-card" onclick="openHot6"><text class="rank">6</text><text class="hot-title">{{h6}}</text></div>
    <div class="hot-card" onclick="openHot7"><text class="rank">7</text><text class="hot-title">{{h7}}</text></div>
    <div class="hot-card" onclick="openHot8"><text class="rank">8</text><text class="hot-title">{{h8}}</text></div>

    <div class="refresh" onclick="loadHot"><text class="refresh-text">刷新热搜榜</text></div>
  </div>
</template>

<script>
import router from '@system.router'
import fetch from '@system.fetch'
import storage from '@system.storage'

export default {
  private: {
    status: '正在加载 B 站热搜...',
    h1: '加载中',
    h2: '加载中',
    h3: '加载中',
    h4: '加载中',
    h5: '加载中',
    h6: '加载中',
    h7: '加载中',
    h8: '加载中',
  },
  onInit() {
    this.loadHot()
  },
  onShow() {
  },
  loadHot() {
    var self = this
    this.status = '正在加载 B 站热搜...'
    fetch.fetch({
      url: 'https://api.bilibili.com/x/web-interface/search/square?limit=8',
      header: {
        'User-Agent': 'Mozilla/5.0'
      },
      responseType: 'json',
      success: function(res) {
        var data = res.data
        if (typeof data === 'string') {
          data = JSON.parse(data)
        }
        var list = []
        if (data && data.data && data.data.trending && data.data.trending.list) {
          list = data.data.trending.list
        } else if (data && data.data && data.data.list) {
          list = data.data.list
        }
        if (list && list.length > 0) {
          self.applyList(list)
        } else {
          self.useFallback()
        }
      },
      fail: function() {
        self.useFallback()
      }
    })
  },
  getKeyword(item) {
    return item.keyword || item.show_name || item.name || item.title || 'B站热搜'
  },
  applyList(list) {
    var i = 0
    for (i = 1; i <= 8; i++) {
      if (list[i - 1]) {
        this['h' + i] = this.getKeyword(list[i - 1])
      }
    }
    this.status = '点击热搜词进入搜索'
  },
  useFallback() {
    this.h1 = '热门动画'
    this.h2 = '科技数码'
    this.h3 = '音乐现场'
    this.h4 = '游戏实况'
    this.h5 = '鬼畜'
    this.h6 = '影视剪辑'
    this.h7 = '美食'
    this.h8 = '学习'
    this.status = '热搜接口失败，显示兜底词'
  },
  openHot(n) {
    router.push({ uri: '/search', params: { keyword: this['h' + n] } })
  },
  openHot1() { this.openHot(1) },
  openHot2() { this.openHot(2) },
  openHot3() { this.openHot(3) },
  openHot4() { this.openHot(4) },
  openHot5() { this.openHot(5) },
  openHot6() { this.openHot(6) },
  openHot7() { this.openHot(7) },
  openHot8() { this.openHot(8) },

  back() {
    router.back()
  }
}
</script>

