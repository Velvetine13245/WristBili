  width: 316px;
  height: 50px;
  flex-direction: row;
  align-items: center;
}
.back-text {
  color: #ffffff;
  font-size: 24px;
  font-weight: bold;
}
.app-card {
  width: 316px;
  height: 84px;
  margin-top: 12px;
  border-radius: 24px;
  background-color: rgba(233,30,99,0.25);
  border-width: 1px;
  border-color: rgba(255,255,255,0.1);
  flex-direction: row;
  align-items: center;
  padding: 0 16px;
}
.app-info {
  flex: 1;
  flex-direction: column;
}
.app-name {
  color: #ffffff;
  font-size: 24px;
  font-weight: bold;
}
.app-sub {
  color: rgba(255,255,255,0.75);
  font-size: 12px;
  margin-top: 3px;
}
.app-dev {
  color: rgba(255,255,255,0.55);
  font-size: 11px;
  margin-top: 2px;
}
.app-arrow {
  color: rgba(255,255,255,0.6);
  font-size: 22px;
}
.app-icon {
  width: 36px;
  height: 36px;
  border-radius: 18px;
  margin-right: 14px;
  flex-shrink: 0;
}
.account-card {
  width: 316px;
  height: 76px;
  margin-top: 8px;
  border-radius: 24px;
  background-color: rgba(255,255,255,0.12);
  border-width: 1px;
  border-color: rgba(255,255,255,0.1);
  flex-direction: row;
  align-items: center;
  padding: 0 16px;
}
.account-avatar {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  margin-right: 14px;
  flex-shrink: 0;
}
.account-info {
  flex: 1;
  flex-direction: column;
}
.account-name {
  color: #ffffff;
  font-size: 20px;
  font-weight: bold;
}
.account-sub {
  color: rgba(255,255,255,0.5);
  font-size: 12px;
  margin-top: 3px;
}
.setting-card {
  width: 316px;
  height: 92px;
  margin-top: 8px;
  border-radius: 24px;
  background-color: rgba(255,255,255,0.12);
  border-width: 1px;
  border-color: rgba(255,255,255,0.1);
  flex-direction: row;
  align-items: center;
  padding: 0 20px;
}
.row-icon {
  width: 52px;
  height: 52px;
  border-radius: 26px;
  background-color: rgba(255,255,255,0.08);
  border-width: 1px;
  border-color: rgba(255,255,255,0.06);
  margin-right: 18px;
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
}
.row-icon-img {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  margin-right: 18px;
  flex-shrink: 0;
}
.icon-text {
  color: #ffffff;
  font-size: 22px;
  font-weight: bold;
}
.play-icon {
  background-color: rgba(255,255,255,0.08);
}
.source-icon {
  background-color: rgba(255,255,255,0.08);
}
.quality-icon {
  background-color: rgba(251,114,153,0.15);
}
.bridge-icon {
  background-color: rgba(255,255,255,0.08);
}
.splash-icon {
  background-color: rgba(255,255,255,0.08);
}
.clear-icon {
  background-color: rgba(255,255,255,0.08);
}
.logout-icon {
  background-color: rgba(255,255,255,0.08);
}
.setting-title {
  color: #ffffff;
  font-size: 24px;
  font-weight: bold;
  flex: 1;
}
.setting-value {
  color: #ffffff;
  font-size: 26px;
  font-weight: bold;
}
.setting-arrow {
  color: rgba(255,255,255,0.5);
  font-size: 30px;
}
.status {
  width: 292px;
  color: rgba(255,255,255,0.4);
  font-size: 11px;
  margin-top: 10px;
  text-align: center;
}
</style>
