  margin-top: 6px;
  border-radius: 20px;
  background-color: rgba(255,255,255,0.025);
  border-width: 1px;
  border-color: rgba(255,255,255,0.05);
  flex-direction: row;
  align-items: center;
  padding: 6px;
}
.cover {
  width: 96px;
  height: 64px;
  border-radius: 14px;
  object-fit: cover;
  border-width: 1px;
  border-color: rgba(255,255,255,0.06);
}
.video-info {
  width: 198px;
  margin-left: 8px;
  flex-direction: column;
}
.video-title {
  color: rgba(255,255,255,0.9);
  font-size: 12px;
  font-weight: bold;
  lines: 2;
  text-overflow: ellipsis;
}
.up-name {
  color: rgba(255,255,255,0.4);
  font-size: 10px;
  margin-top: 5px;
  lines: 1;
  text-overflow: ellipsis;
}
.btn-row {
  width: 318px;
  height: 40px;
  margin-top: 8px;
  flex-direction: row;
  justify-content: center;
}
.wide-btn {
  width: 318px;
  height: 38px;
  border-radius: 20px;
  background-color: rgba(255,255,255,0.03);
  border-width: 1px;
  border-color: rgba(255,255,255,0.06);
  justify-content: center;
  align-items: center;
}
.pink {
  background-color: rgba(251,114,153,0.85);
  border-width: 1px;
  border-color: rgba(255,255,255,0.1);
}
.btn-text {
  color: #ffffff;
  font-size: 13px;
  font-weight: bold;
}
.white {
  color: #ffffff;
}
.summary-card {
  width: 318px;
  height: 210px;
  margin-top: 8px;
  border-radius: 22px;
  background-color: rgba(255,255,255,0.025);
  border-width: 1px;
  border-color: rgba(255,255,255,0.05);
  flex-direction: column;
  padding: 12px;
}
.summary-title {
  color: rgba(251,114,153,0.85);
  font-size: 14px;
  font-weight: bold;
}
.summary-text {
  color: rgba(255,255,255,0.75);
  font-size: 13px;
  margin-top: 8px;
  lines: 10;
  text-overflow: ellipsis;
}
</style>
