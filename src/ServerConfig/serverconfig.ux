<template>
  <div class="page">
    <div class="header">
      <image class="back-icon" src="/common/images/icon_back.jpg" onclick="back" />
      <text class="header-title">服务器地址</text>
    </div>

    <div class="input-card">
      <text class="input-label">服务器 IP:端口</text>
      <input class="input-field" type="text" value="{{serverAddr}}" placeholder="如 192.168.1.100:3000" onchange="onAddrChange" />
    </div>

    <div class="btn-row">
      <div class="btn-save" onclick="saveAddr"><text class="btn-text">保存</text></div>
      <div class="btn-test" onclick="testConn"><text class="btn-text">测试连接</text></div>
    </div>

    <text class="status-text" if="{{statusText}}">{{statusText}}</text>

    <div class="hint-card">
      <text class="hint-title">使用说明</text>
      <text class="hint-line">1. 在服务器上运行视频帧解码服务</text>
      <text class="hint-line">2. 填入服务器的 IP 地址和端口</text>
      <text class="hint-line">3. 选择播放源为"服务器"</text>
      <text class="hint-line">4. 打开视频即可由服务器解码发帧</text>
      <text class="hint-line">5. 推荐 Oracle Cloud 免费实例</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import fetch from '@system.fetch'

export default {
  private: {
    serverAddr: '',
    statusText: ''
  },
  onInit() {
    var self = this
    storage.get({
      key: 'bili_server_addr',
      success: function(data) {
        self.serverAddr = data || ''
      },
      fail: function() {
        self.serverAddr = ''
      }
    })
  },
  onAddrChange(e) {
    this.serverAddr = e.value || ''
  },
  saveAddr() {
    var addr = this.serverAddr.trim()
    storage.set({ key: 'bili_server_addr', value: addr })
    this.statusText = '已保存: ' + addr
  },
  testConn() {
    var self = this
    var addr = this.serverAddr.trim()
    if (!addr) {
      self.statusText = '请先填写地址'
      return
    }
    storage.set({ key: 'bili_server_addr', value: addr })
    self.statusText = '正在测试...'
    fetch.fetch({
      url: 'http://' + addr + '/api/health',
      responseType: 'json',
      timeout: 10000,
      success: function(res) {
        var data = res.data
        if (typeof data === 'string') {
          try { data = JSON.parse(data) } catch(e) {}
        }
        if (data && data.status === 'ok') {
          self.statusText = '连接成功! 服务器: ' + (data.ip || addr)
        } else {
          self.statusText = '连接异常: ' + JSON.stringify(data)
        }
      },
      fail: function() {
        self.statusText = '连接失败，请检查地址和网络'
      }
    })
  },
  back() {
    router.back()
  }
}
</script>

