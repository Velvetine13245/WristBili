.page {
  width: 336px;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  background-image: url(/common/images/bg_pink.png);
  background-size: 120%;
  background-position: center -1px;
  background-repeat: no-repeat;
  padding: 4px 12px;

}
.header {
  width: 312px;
  height: 38px;
  flex-direction: row;
  align-items: center;
}
.back-icon {
  width: 24px;
  height: 24px;
  border-radius: 12px;
}
.header-title {
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
  margin-left: 8px;
}
.qr-card {
  width: 280px;
  background-color: #1a1a1a;
  border-radius: 20px;
  border-width: 1px;
  border-color: rgba(255,255,255,0.12);
  padding: 20px;
  flex-direction: column;
  align-items: center;
  margin-top: 20px;
}
.qr-title {
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 14px;
}
.qr-img {
  width: 160px;
  height: 160px;
  border-radius: 8px;
  background-color: #ffffff;
}
.qr-hint {
  color: rgba(255,255,255,0.5);
  font-size: 11px;
  margin-top: 12px;
  text-align: center;
}
.qr-url {
  color: rgba(251,114,153,0.6);
  font-size: 9px;
  margin-top: 6px;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}
.note {
  width: 300px;
  color: rgba(255,255,255,0.3);
  font-size: 9px;
  text-align: center;
  margin-top: 12px;
}
</style>
