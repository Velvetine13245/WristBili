<template>
  <div class="page">
    <div class="header">
      <image class="back-icon" src="/common/images/icon_back.jpg" onclick="back" />
      <text class="header-title">{{pageTitle}}</text>
    </div>

    <div class="qr-card">
      <text class="qr-title">{{qrTitle}}</text>
      <image class="qr-img" src="{{qrUrl}}" />
      <text class="qr-hint">{{qrHint}}</text>
      <text class="qr-url">{{qrUrlText}}</text>
    </div>

    <text class="note">{{note}}</text>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  private: {
    pageTitle: '手机上看',
    qrTitle: '扫码观看',
    qrUrl: '',
    qrUrlText: '',
    qrHint: '用手机扫描二维码即可观看',
    note: ''
  },
  onInit() {
    var type = this.type || 'video'
    var id = this.id || ''
    var watchUrl = ''
    if (type === 'live') {
      this.pageTitle = '手机看直播'
      this.qrTitle = '扫码看直播'
      this.qrHint = '用手机扫描二维码即可观看直播'
      watchUrl = 'https://live.bilibili.com/' + id
    } else {
      this.pageTitle = '手机上看'
      this.qrTitle = '扫码观看'
      this.qrHint = '用手机扫描二维码即可在手机上观看'
      watchUrl = 'https://www.bilibili.com/video/' + id
    }
    this.qrUrlText = watchUrl
    var encoded = encodeURIComponent(watchUrl)
    this.qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=160x160&margin=1&color=000000&bgcolor=ffffff&qzone=0&data=' + encoded
    this.note = '二维码加载中...'
  },
  onShow() {
  },
  back() {
    router.back()
  }
}
</script>

