      <text class="title">收藏与历史</text>
    </div>

    <div class="tabs">
      <div class="tab" onclick="switchTab('fav')"><text class="tab-text {{tab==='fav'?'tab-active':''}}">收藏</text></div>
      <div class="tab" onclick="switchTab('history')"><text class="tab-text {{tab==='history'?'tab-active':''}}">历史</text></div>
    </div>

    <text class="status">{{status}}</text>

    <div class="list">
      <div class="video-card" if="{{i1Show}}" onclick="playVideo(1)">
        <div class="cover">
          <image class="cover-img" src="{{i1Cover}}" />
        </div>
        <text class="video-title">{{i1Title}}</text>
        <text class="up-name">{{i1Up}}</text>
      </div>
      <div class="video-card" if="{{i2Show}}" onclick="playVideo(2)">
