  color: #fb7299;
}
.status {
  width: 318px;
  color: #fb7299;
  font-size: 13px;
  text-align: center;
  margin-top: 4px;
}
.list {
  width: 320px;
  margin-top: 4px;
  flex-direction: column;
  align-items: center;
}
.video-card {
  width: 316px;
  margin-top: 10px;
  border-radius: 16px;
  background-color: rgba(255,255,255,0.08);
  border-width: 1px;
  border-color: rgba(255,255,255,0.1);
  flex-direction: column;
  padding: 6px;
}
.cover {
  width: 304px;
  height: 162px;
  border-radius: 12px;
  background-color: #fb7299;
  flex-shrink: 0;
}
.cover-img {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 304px;
  height: 162px;
  border-radius: 12px;
  object-fit: cover;
}
.video-title {
  width: 300px;
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
  margin-top: 8px;
  padding: 0 2px;
  lines: 2;
  text-overflow: ellipsis;
}
.up-name {
  width: 300px;
  color: rgba(255,255,255,0.5);
  font-size: 13px;
  margin-top: 4px;
  padding: 0 2px;
  lines: 1;
  text-overflow: ellipsis;
}

</style>
