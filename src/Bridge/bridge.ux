<template>
  <div class="page">
    <div class="header">
      <text class="back-text" onclick="back">⇦ 网桥</text>
    </div>

    <div class="status-card">
      <div class="status-icon-row">
        <div class="status-dot {{statusDotClass}}"></div>
        <text class="status-title">{{statusText}}</text>
      </div>
      <text class="status-desc">{{statusDesc}}</text>
    </div>

    <div class="setting-card" onclick="toggleBridge">
      <text class="setting-title">网桥模式</text>
      <text class="setting-value">{{bridgeToggleText}}</text>
    </div>

    <div class="caps-card" if="{{showCaps}}">
      <text class="caps-title">协商能力</text>
      <text class="caps-text">{{capsText}}</text>
    </div>

    <div class="info-card">
      <text class="info-title">协议说明</text>
      <text class="info-text">FetchBridge v3 协议</text>
      <text class="info-text">通过 QAIC interconnect 通道代理 HTTP 请求至手机端网桥插件，支持分片传输与 ACK 流控。</text>
      <text class="info-text">网桥未就绪时自动降级为直连 fetch。</text>
    </div>

    <div class="setting-card" onclick="testBridge" if="{{bridgeEnabled}}">
      <text class="setting-title">测试连接</text>
      <text class="setting-arrow">›</text>
    </div>

    <text class="status">{{status}}</text>
  </div>
</template>

<script>
import router from '@system.router'
import fetchBridge from '../common/scripts/fetchbridge'

export default {
  private: {
    statusText: '已关闭',
    statusDesc: '网桥模式未开启',
    statusDotClass: 'dot-off',
    bridgeToggleText: '关',
    bridgeEnabled: false,
    showCaps: false,
    capsText: '',
    status: ''
  },
  onShow() {
  },
  onInit() {
    var self = this
    this.refreshStatus()
    fetchBridge.onStatusChange(function(st) {
      self.refreshStatus()
    })
  },
  refreshStatus() {
    var s = fetchBridge.getStatus()
    this.bridgeEnabled = fetchBridge.getStatus() !== 'disabled'
    if (s === 'disabled') {
      this.statusText = '已关闭'
      this.statusDesc = '网桥模式未开启，所有请求走直连'
      this.statusDotClass = 'dot-off'
      this.bridgeToggleText = '关'
      this.showCaps = false
    } else if (s === 'connecting') {
      this.statusText = '连接中...'
      this.statusDesc = '正在建立 interconnect 会话'
      this.statusDotClass = 'dot-connecting'
      this.bridgeToggleText = '开'
      this.showCaps = false
    } else if (s === 'handshaking') {
      this.statusText = '握手协商中...'
      this.statusDesc = '会话已建立，正在进行能力协商'
      this.statusDotClass = 'dot-connecting'
      this.bridgeToggleText = '开'
      this.showCaps = false
    } else if (s === 'ready') {
      this.statusText = '已就绪'
      this.statusDesc = '网桥连接正常，请求将通过网桥代理'
      this.statusDotClass = 'dot-on'
      this.bridgeToggleText = '开'
      this.showCaps = true
      this.capsText = fetchBridge.getNegotiatedText()
    }
  },
  toggleBridge() {
    fetchBridge.toggle()
    var self = this
    setTimeout(function() {
      self.refreshStatus()
    }, 100)
    if (fetchBridge.getStatus() === 'disabled') {
      this.status = '网桥已关闭'
    } else {
      this.status = '网桥已开启，正在连接...'
    }
  },
  testBridge() {
    var self = this
    this.status = '正在测试...'
    fetchBridge.fetch({
      url: 'https://api.bilibili.com/x/web-interface/online',
      responseType: 'json',
      timeout: 15000,
      success: function(res) {
        var data = res.data
        if (typeof data === 'string') {
          data = JSON.parse(data)
        }
        if (data && data.code === 0) {
          self.status = '测试成功：网桥通信正常'
        } else {
          self.status = '测试完成：返回码 ' + (data ? data.code : '未知')
        }
        self.refreshStatus()
      },
      fail: function() {
        self.status = '测试失败：请检查网桥连接'
        self.refreshStatus()
      }
    })
  },
  back() {
    router.back()
  }
}
</script>

