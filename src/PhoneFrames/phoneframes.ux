<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="back"><text class="back-text">‹</text></div>
      <text class="title">手机帧</text>
    </div>

    <div class="player">
      <image class="frame-img" src="{{currentFrame}}" />
      <text class="player-tip">{{status}}</text>
    </div>

    <div class="btn-row">
      <div class="btn" onclick="startPlay"><text class="btn-text">播放</text></div>
      <div class="btn pink" onclick="stopPlay"><text class="btn-text white">停止</text></div>
    </div>

    <div class="info-card">
      <text class="info-title">手机上传视频帧</text>
      <text class="info-line">帧数：{{frameCount}}</text>
      <text class="info-line">当前：{{frameText}}</text>
      <text class="info-line">来源：{{sourceText}}</text>
    </div>

    <text class="tip">手机工具会把视频转换为图片帧。手环端只负责按顺序播放图片 URL。</text>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'

export default {
  private: {
    frames: [],
    currentFrame: '/common/images/icon.png',
    frameIndex: 0,
    frameCount: '0',
    frameText: '-',
    sourceText: '等待手机工具导入',
    status: '准备播放手机帧',
    timer: null
  },
  onInit() {
    this.loadFrames()
  },
  onShow() {
  },
  loadFrames() {
    var self = this
    storage.get({
      key: 'phone_frame_manifest',
      success: function(data) {
        if (data && data.length > 10) {
          self.applyManifest(data)
        } else {
          self.loadLegacyFrames()
        }
      },
      fail: function() {
        self.loadLegacyFrames()
      }
    })
  },
  loadLegacyFrames() {
    var self = this
    storage.get({
      key: 'phone_frame_urls',
      success: function(data) {
        if (data && data.length > 5) {
          self.applyFrames(data)
        } else {
          self.useDemoFrames()
        }
      },
      fail: function() {
        self.useDemoFrames()
      }
    })
  },
  applyManifest(jsonText) {
    var manifest = null
    try {
      manifest = JSON.parse(jsonText)
    } catch (e) {
      this.useDemoFrames()
      return
    }
    if (!manifest || !manifest.frames || manifest.frames.length === 0) {
      this.useDemoFrames()
      return
    }
    var frames = []
    var i = 0
    for (i = 0; i < manifest.frames.length; i++) {
      var item = manifest.frames[i]
      var url = item.url || item.name || ''
      if (url) {
        if (url.indexOf('http') === 0) {
          frames.push(url)
        } else if (url.indexOf('/') === 0) {
          frames.push(url)
        } else {
          frames.push('/common/images/frames/' + url)
        }
      }
    }
    if (frames.length === 0) {
      this.useDemoFrames()
      return
    }
    this.frames = frames
    this.frameCount = '' + frames.length
    this.sourceText = '手机导入 (' + (manifest.width || '-') + 'x' + (manifest.height || '-') + ')'
    this.currentFrame = frames[0]
    this.frameText = '1 / ' + frames.length
  },
  applyFrames(text) {
    var list = text.split('|')
    var frames = []
    var i = 0
    for (i = 0; i < list.length; i++) {
      if (list[i] && list[i].indexOf('http') === 0) {
        frames.push(list[i])
      }
    }
    if (frames.length === 0) {
      this.useDemoFrames()
      return
    }
    this.frames = frames
    this.frameCount = '' + frames.length
    this.sourceText = '手机导入'
    this.currentFrame = frames[0]
    this.frameText = '1 / ' + frames.length
  },
  useDemoFrames() {
    this.frames = [
      '/common/images/icon.png',
      '/common/images/icon.png',
      '/common/images/icon.png'
    ]
    this.frameCount = '3'
    this.sourceText = '示例'
    this.currentFrame = this.frames[0]
    this.frameText = '1 / 3'
  },
  startPlay() {
    var self = this
    if (!this.frames || this.frames.length === 0) {
      this.status = '没有可播放帧'
      return
    }
    if (this.timer) {
      clearInterval(this.timer)
    }
    this.status = '手机帧播放中'
    this.timer = setInterval(function() {
      self.frameIndex = self.frameIndex + 1
      if (self.frameIndex >= self.frames.length) {
        self.frameIndex = 0
      }
      self.currentFrame = self.frames[self.frameIndex]
      self.frameText = (self.frameIndex + 1) + ' / ' + self.frames.length
    }, 125)
  },
  stopPlay() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
    this.status = '已停止'
  },
  back() {
    this.stopPlay()
    router.back()
  },
  onDestroy() {
    this.stopPlay()
    this.frames = []
    this.currentFrame = '/common/images/icon.png'
  }
}
</script>

<style>
.page {
  width: 336px;
  height: 480px;
  flex-direction: column;
  align-items: center;
  background-color: #fff3f8;
  background-image: linear-gradient(to bottom, #ffffff, #ffe3ef);
  padding: 10px;

}
.header {
  width: 316px;
  height: 40px;
  flex-direction: row;
  align-items: center;
}
.back {
  width: 36px;
  height: 36px;
  justify-content: center;
  align-items: center;
}
.back-text {
  color: #3a1728;
  font-size: 32px;
}
.title {
  color: #3a1728;
  font-size: 20px;
  font-weight: bold;
  margin-left: 8px;
}
.player {
  width: 312px;
  height: 210px;
  border-radius: 22px;
  background-color: rgba(0,0,0,0.06);
  border-width: 1px;
  border-color: rgba(255,255,255,0.12);
  margin-top: 8px;
  justify-content: flex-end;
  flex-direction: column;
  overflow: hidden;
}
.frame-img {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 312px;
  height: 210px;
  object-fit: cover;
}
.player-tip {
  color: #ffffff;
  font-size: 12px;
  margin-top: 8px;
  background-color: rgba(0,0,0,0.42);
  border-width: 1px;
  border-color: rgba(255,255,255,0.12);
  border-radius: 10px;
  padding: 3px 8px;
}
.btn-row {
  width: 304px;
  height: 38px;
  margin-top: 10px;
  flex-direction: row;
  justify-content: space-between;
}
.btn {
  width: 146px;
  height: 34px;
  border-radius: 17px;
  background-color: rgba(255,255,255,0.86);
  border-width: 1px;
  border-color: rgba(255,255,255,0.12);
  justify-content: center;
  align-items: center;
}
.pink {
  background-color: #fb7299;
}
.btn-text {
  color: #3a1728;
  font-size: 13px;
}
.white {
  color: #ffffff;
  font-weight: bold;
}
.info-card {
  width: 304px;
  height: 108px;
  margin-top: 10px;
  border-radius: 16px;
  background-color: rgba(255,255,255,0.78);
  border-width: 1px;
  border-color: rgba(255,255,255,0.12);
  flex-direction: column;
  padding: 10px;
}
.info-title {
  color: #3a1728;
  font-size: 14px;
  font-weight: bold;
}
.info-line {
  color: rgba(58,23,40,0.58);
  font-size: 11px;
  margin-top: 6px;
}
.tip {
  width: 300px;
  color: rgba(58,23,40,0.42);
  font-size: 10px;
  text-align: center;
  margin-top: 10px;
}
</style>
