  border-width: 1px;
  border-color: rgba(255,255,255,0.12);
  flex-direction: column;
  padding: 10px 16px;
}
.detail-row {
  width: 284px;
  height: 32px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.detail-label {
  color: rgba(255,255,255,0.6);
  font-size: 13px;
}
