<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="back"><text class="back-text">‹</text></div>
      <text class="title">清除缓存</text>
    </div>

    <div class="cache-card">
      <image class="cache-icon" src="/common/images/settings_removetmp.png" />
      <text class="cache-label">当前缓存大小</text>
      <text class="cache-size">{{cacheSizeText}}</text>
    </div>

    <div class="detail-card">
      <div class="detail-row">
        <text class="detail-label">视频帧缓存</text>
        <text class="detail-value">{{frameSizeText}}</text>
      </div>
      <div class="detail-row">
        <text class="detail-label">稍后再看</text>
        <text class="detail-value">{{watchlaterSizeText}}</text>
      </div>
      <div class="detail-row">
        <text class="detail-label">头像缓存</text>
        <text class="detail-value">{{avatarSizeText}}</text>
      </div>
      <div class="detail-row">
        <text class="detail-label">登录数据</text>
        <text class="detail-value">{{loginSizeText}}</text>
      </div>
    </div>

    <div class="btn" onclick="doClearCache">
      <text class="btn-text">清除缓存</text>
    </div>

    <text class="result {{resultType}}" if="{{resultText}}">{{resultText}}</text>

    <text class="tip">清除缓存不会影响登录状态和设置项</text>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'

export default {
  private: {
    cacheSizeText: '0.00 MB',
    frameSizeText: '0.00 KB',
    watchlaterSizeText: '0.00 KB',
    avatarSizeText: '0.00 KB',
    loginSizeText: '0.00 KB',
    resultText: '',
    resultType: ''
  },
  onShow() {
  },
  onInit() {
    this.calculateCacheSize()
  },
  getByteSize(str) {
    if (!str) return 0
    var size = 0
    var i = 0
    for (i = 0; i < str.length; i++) {
      var charCode = str.charCodeAt(i)
      if (charCode < 128) {
        size += 1
      } else if (charCode < 2048) {
        size += 2
      } else {
        size += 3
      }
    }
    return size
  },
  formatSize(bytes) {
    if (bytes < 1024) {
      return bytes.toFixed(0) + ' B'
    }
    if (bytes < 1024 * 1024) {
      return (bytes / 1024).toFixed(2) + ' KB'
    }
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB'
  },
  calculateCacheSize() {
    var self = this
    var frameSize = 0
    var watchlaterSize = 0
    var avatarSize = 0
    var loginSize = 0
    var pending = 5
    function done() {
      pending--
      if (pending <= 0) {
        var total = frameSize + watchlaterSize + avatarSize + loginSize
        self.cacheSizeText = self.formatSize(total)
        self.frameSizeText = self.formatSize(frameSize)
        self.watchlaterSizeText = self.formatSize(watchlaterSize)
        self.avatarSizeText = self.formatSize(avatarSize)
        self.loginSizeText = self.formatSize(loginSize)
      }
    }
    storage.get({
      key: 'phone_frame_urls',
      success: function(data) { frameSize += self.getByteSize(data); done() },
      fail: function() { done() }
    })
    storage.get({
      key: 'phone_frame_manifest',
      success: function(data) { frameSize += self.getByteSize(data); done() },
      fail: function() { done() }
    })
    storage.get({
      key: 'bili_watchlater',
      success: function(data) { watchlaterSize = self.getByteSize(data); done() },
      fail: function() { done() }
    })
    storage.get({
      key: 'bili_avatar_cached',
      success: function(data) { avatarSize = self.getByteSize(data); done() },
      fail: function() { done() }
    })
    storage.get({
      key: 'bili_login_url',
      success: function(data) { loginSize = self.getByteSize(data); done() },
      fail: function() { done() }
    })
  },
  doClearCache() {
    var self = this
    var cleared = 0
    var failed = 0
    var pending = 4
    function checkResult() {
      pending--
      if (pending <= 0) {
        if (failed === 0) {
          self.resultText = '清理成功'
          self.resultType = 'success'
        } else {
          self.resultText = '清理失败'
          self.resultType = 'fail'
        }
        setTimeout(function() {
          self.calculateCacheSize()
        }, 300)
      }
    }
    storage.set({
      key: 'phone_frame_urls',
      value: '',
      success: function() { cleared++; checkResult() },
      fail: function() { failed++; checkResult() }
    })
    storage.set({
      key: 'phone_frame_manifest',
      value: '',
      success: function() { cleared++; checkResult() },
      fail: function() { failed++; checkResult() }
    })
    storage.set({
      key: 'bili_watchlater',
      value: '[]',
      success: function() { cleared++; checkResult() },
      fail: function() { failed++; checkResult() }
    })
    storage.delete({
      key: 'bili_avatar_cached',
      success: function() { cleared++; checkResult() },
      fail: function() { failed++; checkResult() }
    })
  },
  back() {
    router.back()
  }
}
</script>

