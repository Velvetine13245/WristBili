.page {
  width: 336px;
  height: 480px;
  flex-direction: column;
  align-items: center;
  background-color: #fff3f8;
  background-image: linear-gradient(to bottom, #ffffff, #ffe3ef);
  padding: 8px;

}
.header {
  width: 316px;
  height: 38px;
  flex-direction: row;
  align-items: center;
}
.back {
  width: 32px;
  height: 32px;
  justify-content: center;
  align-items: center;
}
.back-text {
  color: #3a1728;
  font-size: 30px;
}
.title {
  color: #3a1728;
  font-size: 18px;
  font-weight: bold;
  margin-left: 6px;
}
.sub-title {
  color: rgba(58,23,40,0.5);
  font-size: 12px;
  margin-top: 4px;
  margin-bottom: 4px;
}
.list {
  width: 316px;
  flex-direction: column;
  align-items: center;
}
.splash-item {
  width: 300px;
  height: 70px;
  margin-top: 4px;
  border-radius: 12px;
  background-color: rgba(255,255,255,0.85);
  border-width: 1px;
  border-color: rgba(255,255,255,0.12);
  flex-direction: row;
  align-items: center;
  padding: 4px 8px;
}
.splash-thumb {
  width: 52px;
  height: 52px;
  border-radius: 8px;
  object-fit: cover;
}
.splash-name {
  flex: 1;
  margin-left: 10px;
  font-size: 14px;
  font-weight: bold;
}
.name-normal {
  color: #3a1728;
}
.name-active {
  color: #fb7299;
}
.status {
  width: 292px;
  color: #fb7299;
  font-size: 11px;
  margin-top: 6px;
  text-align: center;
}
</style>
