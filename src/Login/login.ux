<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="back"><text class="back-text">‹</text></div>
      <text class="title">扫码登录</text>
    </div>

    <div class="qr-card">
      <image class="qr-img" src="{{qrImg}}" />
      <text class="qr-title">用 B站 客户端扫码</text>
      <text class="qr-sub">{{status}}</text>
    </div>

    <div class="btn-row">
      <div class="btn" onclick="createQr"><text class="btn-text">刷新二维码</text></div>
      <div class="btn pink" onclick="checkNow"><text class="btn-text white">检查登录</text></div>
    </div>
    <div class="btn-row small-row">
      <div class="btn full" onclick="switchQrSource"><text class="btn-text">二维码不显示？点这里换源</text></div>
    </div>

    <text class="url-tip">{{urlTip}}</text>
    <text class="tip">TV端官方接口登录，Cookie直接从响应体获取，无需解析响应头。</text>
  </div>
</template>

<script>
import router from '@system.router'
import fetch from '@system.fetch'
import storage from '@system.storage'

export default {
  private: {
    qrUrl: '',
    qrImg: '/common/images/icon.png',
    authCode: '',
    qrSource: 0,
    urlTip: '',
    status: '正在生成二维码...',
    timer: null,
    appkey: '4409e2ce8ffd12b8',
    appsec: '59b43e04ad6965f34319062b478f83dd'
  },
  onShow() {
  },
  onInit() {
    this.createQr()
  },
  md5(str) {
    function safeAdd(x, y) {
      var lsw = (x & 0xffff) + (y & 0xffff)
      var msw = (x >> 16) + (y >> 16) + (lsw >> 16)
      return (msw << 16) | (lsw & 0xffff)
    }
    function bitRol(num, cnt) {
      return (num << cnt) | (num >>> (32 - cnt))
    }
    function cmn(q, a, b, x, s, t) {
      return safeAdd(bitRol(safeAdd(safeAdd(a, q), safeAdd(x, t)), s), b)
    }
    function ff(a, b, c, d, x, s, t) { return cmn((b & c) | ((~b) & d), a, b, x, s, t) }
    function gg(a, b, c, d, x, s, t) { return cmn((b & d) | (c & (~d)), a, b, x, s, t) }
    function hh(a, b, c, d, x, s, t) { return cmn(b ^ c ^ d, a, b, x, s, t) }
    function ii(a, b, c, d, x, s, t) { return cmn(c ^ (b | (~d)), a, b, x, s, t) }
    function binlMD5(x, len) {
      x[len >> 5] |= 0x80 << (len % 32)
      x[(((len + 64) >>> 9) << 4) + 14] = len
      var i, olda, oldb, oldc, oldd, a = 1732584193, b = -271733879, c = -1732584194, d = 271733878
      for (i = 0; i < x.length; i += 16) {
        olda = a; oldb = b; oldc = c; oldd = d
        a = ff(a, b, c, d, x[i], 7, -680876936)
        d = ff(d, a, b, c, x[i + 1], 12, -389564586)
        c = ff(c, d, a, b, x[i + 2], 17, 606105819)
        b = ff(b, c, d, a, x[i + 3], 22, -1044525330)
        a = ff(a, b, c, d, x[i + 4], 7, -176418897)
        d = ff(d, a, b, c, x[i + 5], 12, 1200080426)
        c = ff(c, d, a, b, x[i + 6], 17, -1473231341)
        b = ff(b, c, d, a, x[i + 7], 22, -45705983)
        a = ff(a, b, c, d, x[i + 8], 7, 1770035416)
        d = ff(d, a, b, c, x[i + 9], 12, -1958414417)
        c = ff(c, d, a, b, x[i + 10], 17, -42063)
        b = ff(b, c, d, a, x[i + 11], 22, -1990404162)
        a = ff(a, b, c, d, x[i + 12], 7, 1804603682)
        d = ff(d, a, b, c, x[i + 13], 12, -40341101)
        c = ff(c, d, a, b, x[i + 14], 17, -1502002290)
        b = ff(b, c, d, a, x[i + 15], 22, 1236535329)
        a = gg(a, b, c, d, x[i + 1], 5, -165796510)
        d = gg(d, a, b, c, x[i + 6], 9, -1069501632)
        c = gg(c, d, a, b, x[i + 11], 14, 643717713)
        b = gg(b, c, d, a, x[i], 20, -373897302)
        a = gg(a, b, c, d, x[i + 5], 5, -701558691)
        d = gg(d, a, b, c, x[i + 10], 9, 38016083)
        c = gg(c, d, a, b, x[i + 15], 14, -660478335)
        b = gg(b, c, d, a, x[i + 4], 20, -405537848)
        a = gg(a, b, c, d, x[i + 9], 5, 568446438)
        d = gg(d, a, b, c, x[i + 14], 9, -1019803690)
        c = gg(c, d, a, b, x[i + 3], 14, -187363961)
        b = gg(b, c, d, a, x[i + 8], 20, 1163531501)
        a = gg(a, b, c, d, x[i + 13], 5, -1444681467)
        d = gg(d, a, b, c, x[i + 2], 9, -51403784)
        c = gg(c, d, a, b, x[i + 7], 14, 1735328473)
        b = gg(b, c, d, a, x[i + 12], 20, -1926607734)
        a = hh(a, b, c, d, x[i + 5], 4, -378558)
        d = hh(d, a, b, c, x[i + 8], 11, -2022574463)
        c = hh(c, d, a, b, x[i + 11], 16, 1839030562)
        b = hh(b, c, d, a, x[i + 14], 23, -35309556)
        a = hh(a, b, c, d, x[i + 1], 4, -1530992060)
        d = hh(d, a, b, c, x[i + 4], 11, 1272893353)
        c = hh(c, d, a, b, x[i + 7], 16, -155497632)
        b = hh(b, c, d, a, x[i + 10], 23, -1094730640)
        a = hh(a, b, c, d, x[i + 13], 4, 681279174)
        d = hh(d, a, b, c, x[i], 11, -358537222)
        c = hh(c, d, a, b, x[i + 3], 16, -722521979)
        b = hh(b, c, d, a, x[i + 6], 23, 76029189)
        a = hh(a, b, c, d, x[i + 9], 4, -640364487)
        d = hh(d, a, b, c, x[i + 12], 11, -421815835)
        c = hh(c, d, a, b, x[i + 15], 16, 530742520)
        b = hh(b, c, d, a, x[i + 2], 23, -995338651)
        a = ii(a, b, c, d, x[i], 6, -198630844)
        d = ii(d, a, b, c, x[i + 7], 10, 1126891415)
        c = ii(c, d, a, b, x[i + 14], 15, -1416354905)
        b = ii(b, c, d, a, x[i + 5], 21, -57434055)
        a = ii(a, b, c, d, x[i + 12], 6, 1700485571)
        d = ii(d, a, b, c, x[i + 3], 10, -1894986606)
        c = ii(c, d, a, b, x[i + 10], 15, -1051523)
        b = ii(b, c, d, a, x[i + 1], 21, -2054922799)
        a = ii(a, b, c, d, x[i + 8], 6, 1873313359)
        d = ii(d, a, b, c, x[i + 15], 10, -30611744)
        c = ii(c, d, a, b, x[i + 6], 15, -1560198380)
        b = ii(b, c, d, a, x[i + 13], 21, 1309151649)
        a = ii(a, b, c, d, x[i + 4], 6, -145523070)
        d = ii(d, a, b, c, x[i + 11], 10, -1120210379)
        c = ii(c, d, a, b, x[i + 2], 15, 718787259)
        b = ii(b, c, d, a, x[i + 9], 21, -343485551)
        a = safeAdd(a, olda); b = safeAdd(b, oldb); c = safeAdd(c, oldc); d = safeAdd(d, oldd)
      }
      return [a, b, c, d]
    }
    function binl2hex(binarray) {
      var hexTab = '0123456789abcdef', str = '', i
      for (i = 0; i < binarray.length * 4; i++) {
        str += hexTab.charAt((binarray[i >> 2] >> ((i % 4) * 8 + 4)) & 0xf) + hexTab.charAt((binarray[i >> 2] >> ((i % 4) * 8)) & 0xf)
      }
      return str
    }
    function str2binl(str) {
      var bin = [], mask = (1 << 8) - 1, i
      for (i = 0; i < str.length * 8; i += 8) {
        bin[i >> 5] |= (str.charCodeAt(i / 8) & mask) << (i % 32)
      }
      return bin
    }
    var s = str
    var utf8 = ''
    for (var i = 0; i < s.length; i++) {
      var c = s.charCodeAt(i)
      if (c < 128) {
        utf8 += s.charAt(i)
      } else if (c < 2048) {
        utf8 += String.fromCharCode((c >> 6) | 192, (c & 63) | 128)
      } else {
        utf8 += String.fromCharCode((c >> 12) | 224, ((c >> 6) & 63) | 128, (c & 63) | 128)
      }
    }
    return binl2hex(binlMD5(str2binl(utf8), utf8.length * 8))
  },
  signParams(params) {
    return this.md5(params + this.appsec)
  },
  createQr() {
    var self = this
    this.status = '正在请求 B站 TV端二维码...'
    var ts = Math.floor(new Date().getTime() / 1000).toString()
    var params = 'appkey=' + this.appkey + '&local_id=0&ts=' + ts
    var sign = this.signParams(params)
    var body = params + '&sign=' + sign
    fetch.fetch({
      url: 'https://passport.bilibili.com/x/passport-tv-login/qrcode/auth_code',
      method: 'POST',
      data: body,
      responseType: 'json',
      timeout: 15000,
      header: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:129.0) Gecko/20100101 Firefox/129.0'
      },
      success: function(res) {
        var data = res.data
        if (typeof data === 'string') {
          try {
            data = JSON.parse(data)
          } catch (e) {
            self.status = '数据解析异常，重试中...'
            setTimeout(function() { self.createQr() }, 2000)
            return
          }
        }
        if (data && data.code === 0 && data.data && data.data.url) {
          self.qrUrl = data.data.url
          self.authCode = data.data.auth_code
          self.updateQrImage()
          self.urlTip = 'auth_code: ' + self.authCode.substring(0, 8) + '...'
          self.status = '请用 B站 客户端扫码'
          self.startPoll()
        } else {
          self.status = '二维码接口错误: ' + (data ? data.code : 'null')
          setTimeout(function() { self.createQr() }, 2000)
        }
      },
      fail: function() {
        self.status = '二维码生成失败，自动重试...'
        setTimeout(function() { self.createQr() }, 2000)
      }
    })
  },
  updateQrImage() {
    var encoded = encodeURIComponent(this.qrUrl)
    if (this.qrSource === 0) {
      this.qrImg = 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=' + encoded
    } else if (this.qrSource === 1) {
      this.qrImg = 'https://quickchart.io/qr?size=220&text=' + encoded
    } else {
      this.qrImg = 'https://chart.googleapis.com/chart?cht=qr&chs=220x220&chl=' + encoded
    }
  },
  switchQrSource() {
    if (!this.qrUrl) {
      this.status = '请先刷新二维码'
      return
    }
    this.qrSource = this.qrSource + 1
    if (this.qrSource > 2) {
      this.qrSource = 0
    }
    this.updateQrImage()
    this.status = '已切换二维码源 ' + (this.qrSource + 1)
  },
  startPoll() {
    var self = this
    if (this.timer) {
      clearInterval(this.timer)
    }
    this.timer = setInterval(function() {
      self.checkNow()
    }, 2000)
  },
  checkNow() {
    var self = this
    if (!this.authCode) {
      this.status = '请先刷新二维码'
      return
    }
    var ts = Math.floor(new Date().getTime() / 1000).toString()
    var params = 'appkey=' + this.appkey + '&auth_code=' + this.authCode + '&local_id=0&ts=' + ts
    var sign = this.signParams(params)
    var body = params + '&sign=' + sign
    fetch.fetch({
      url: 'https://passport.bilibili.com/x/passport-tv-login/qrcode/poll',
      method: 'POST',
      data: body,
      responseType: 'json',
      timeout: 10000,
      header: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:129.0) Gecko/20100101 Firefox/129.0'
      },
      success: function(res) {
        var data = res.data
        if (typeof data === 'string') {
          try {
            data = JSON.parse(data)
          } catch (e) {
            self.status = '数据解析异常，等待重试...'
            return
          }
        }
        if (!data) {
          self.status = '等待扫码...'
          return
        }
        if (data.code === 0 && data.data) {
          if (self.timer) {
            clearInterval(self.timer)
            self.timer = null
          }
          self.status = '登录成功，正在提取Cookie...'
          var cookie = self.extractCookiesFromBody(data.data)
          if (cookie) {
            storage.set({ key: 'bili_cookie', value: cookie })
            storage.set({ key: 'bili_login_ok', value: '1' })
            if (data.data.access_token) {
              storage.set({ key: 'bili_access_token', value: data.data.access_token })
            }
            if (data.data.refresh_token) {
              storage.set({ key: 'bili_refresh_token', value: data.data.refresh_token })
            }
            if (data.data.mid) {
              storage.set({ key: 'bili_mid', value: '' + data.data.mid })
            }
            self.status = '登录成功！'
            setTimeout(function() {
              router.back()
            }, 1000)
          } else {
            self.status = 'Cookie提取失败，请重新扫码'
            self.authCode = ''
            setTimeout(function() {
              self.createQr()
            }, 1500)
          }
        } else if (data.code === 86038) {
          self.status = '二维码过期，自动刷新中...'
          self.authCode = ''
          self.createQr()
        } else if (data.code === 86090) {
          self.status = '已扫码，请在手机确认'
        } else if (data.code === 86039) {
          self.status = '等待扫码...'
        } else {
          self.status = '等待扫码...'
        }
      },
      fail: function() {
        self.status = '网络检查中...'
      }
    })
  },
  extractCookiesFromBody(dataObj) {
    var parts = []
    if (dataObj.cookie_info && dataObj.cookie_info.cookies) {
      var cookies = dataObj.cookie_info.cookies
      for (var i = 0; i < cookies.length; i++) {
        var c = cookies[i]
        if (c.name && c.value) {
          parts.push(c.name + '=' + c.value)
        }
      }
    }
    if (parts.length > 0) {
      return parts.join('; ')
    }
    return ''
  },
  back() {
    router.back()
  },
  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  }
}
</script>

