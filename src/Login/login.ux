  background-color: rgba(255,255,255,0.86);
  border-width: 1px;
  border-color: rgba(255,255,255,0.12);
  align-items: center;
  justify-content: center;
  flex-direction: column;
}
.qr-img {
  width: 220px;
  height: 220px;
  border-radius: 10px;
}
.qr-title {
  color: #3a1728;
  font-size: 16px;
  font-weight: bold;
  margin-top: 10px;
}
.qr-sub {
  color: rgba(58,23,40,0.58);
  font-size: 12px;
  margin-top: 6px;
}
.btn-row {
  width: 300px;
  height: 42px;
  margin-top: 12px;
  flex-direction: row;
  justify-content: space-between;
}
.small-row {
  margin-top: 4px;
}
.btn {
  width: 142px;
  height: 38px;
  border-radius: 19px;
  background-color: rgba(255,255,255,0.86);
  border-width: 1px;
  border-color: rgba(255,255,255,0.12);
  justify-content: center;
  align-items: center;
}
.pink {
  background-color: #fb7299;
}
.full {
  width: 300px;
}
.btn-text {
  color: #3a1728;
  font-size: 13px;
}
.white {
  color: #ffffff;
  font-weight: bold;
}
.url-tip {
  width: 300px;
