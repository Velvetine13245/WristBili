<import name="input-method" src="../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="back"><text class="back-text">‹</text></div>
      <text class="title">漫画</text>
    </div>

    <div class="search-actions">
      <div class="search-btn" onclick="back"><text class="search-btn-text">返回</text></div>
      <div class="search-btn pink" onclick="doSearch"><text class="search-btn-text white">搜索</text></div>
    </div>

    <div class="input-box" onclick="showKeyboard">
      <text class="input-text">{{keyword}}</text>
      <text class="cursor" if="{{showCursor}}">|</text>
    </div>

    <text class="status">{{status}}</text>

    <div class="list">
      <div class="manga-card" onclick="open1" if="{{m1Show}}">
        <image class="manga-cover" src="{{m1Cover}}" />
        <div class="manga-info">
          <text class="manga-title">{{m1Title}}</text>
          <text class="manga-author">{{m1Author}}</text>
        </div>
      </div>
      <div class="manga-card" onclick="open2" if="{{m2Show}}">
        <image class="manga-cover" src="{{m2Cover}}" />
        <div class="manga-info">
          <text class="manga-title">{{m2Title}}</text>
          <text class="manga-author">{{m2Author}}</text>
        </div>
      </div>
      <div class="manga-card" onclick="open3" if="{{m3Show}}">
        <image class="manga-cover" src="{{m3Cover}}" />
        <div class="manga-info">
          <text class="manga-title">{{m3Title}}</text>
          <text class="manga-author">{{m3Author}}</text>
        </div>
      </div>
      <div class="manga-card" onclick="open4" if="{{m4Show}}">
        <image class="manga-cover" src="{{m4Cover}}" />
        <div class="manga-info">
          <text class="manga-title">{{m4Title}}</text>
          <text class="manga-author">{{m4Author}}</text>
        </div>
      </div>
    </div>

    <input-method
      hide="{{!keyboardShow}}"
      keyboardtype="QWERTY"
      maxlength="5"
      screentype="rect"
      vibratemode="short"
      @complete="onInputComplete"
      @delete="onInputDelete"
    ></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import fetch from '@system.fetch'

function cleanUrl(url) {
  if (!url) return ''
  if (url.indexOf('http') !== 0 && url.indexOf('//') === 0) {
    return 'https:' + url
  }
  return url
}

function compressCover(url) {
  if (!url) return ''
  url = cleanUrl(url)
  if (url.indexOf('hdslb.com') > 0 || url.indexOf('biliimg.com') > 0) {
    if (url.indexOf('@') < 0) {
      url = url + '@60w_80h_1e_1c.jpg'
    }
  }
  return url
}

export default {
  private: {
    status: '正在加载推荐漫画...',
    keyword: '',
    showCursor: true,
    cursorTimer: null,
    keyboardShow: false,
    mangaList: [],
    m1Show: false, m1Id: '', m1Title: '', m1Author: '', m1Cover: '',
    m2Show: false, m2Id: '', m2Title: '', m2Author: '', m2Cover: '',
    m3Show: false, m3Id: '', m3Title: '', m3Author: '', m3Cover: '',
    m4Show: false, m4Id: '', m4Title: '', m4Author: '', m4Cover: '',
  },
  onInit() {
    var self = this
    this.cursorTimer = setInterval(function() {
      self.showCursor = !self.showCursor
    }, 600)
    this.loadHomeFeedProxy()
  },
  onShow() {
  },
  loadHomeFeedProxy() {
    var self = this
    this.status = '正在加载推荐...'
    fetch.fetch({
      url: 'https://apis.netstart.cn/bcomic/HomeFeed?pageNum=1&pageSize=4',
      method: 'GET',
      header: {
        'User-Agent': 'Mozilla/5.0'
      },
      responseType: 'json',
      success: function(res) {
        var data = res.data
        if (typeof data === 'string') {
          try { data = JSON.parse(data) } catch (e) { data = null }
        }
        if (!data || data.code !== 0) {
          self.status = '推荐加载失败，请输入关键词搜索'
          return
        }
        var feeds = data.data && data.data.feeds ? data.data.feeds : []
        if (feeds.length === 0) {
          self.status = '暂无推荐，请输入关键词搜索'
          return
        }
        var list = []
        var i = 0
        for (i = 0; i < feeds.length && i < 4; i++) {
          var f = feeds[i]
          list.push({
            id: f.item_id || f.parent_id || '',
            title: f.title || '未知标题',
            author_name: [],
            vertical_cover: f.image || '',
            square_cover: f.image || '',
            horizontal_cover: f.image || ''
          })
        }
        self.mangaList = list
        self.applyList(list)
        self.status = '推荐 ' + list.length + ' 部漫画'
      },
      fail: function() {
        self.status = '推荐加载失败，请输入关键词搜索'
      }
    })
  },
  applyList(list) {
    var i = 0
    for (i = 1; i <= 4; i++) {
      this['m' + i + 'Show'] = false
      this['m' + i + 'Id'] = ''
      this['m' + i + 'Title'] = ''
      this['m' + i + 'Author'] = ''
      this['m' + i + 'Cover'] = ''
    }
    for (i = 0; i < list.length && i < 4; i++) {
      var item = list[i]
      var n = i + 1
      this['m' + n + 'Show'] = true
      this['m' + n + 'Id'] = '' + (item.id || item.comic_id || '')
      this['m' + n + 'Title'] = item.title || '未知标题'
      var authors = item.author_name || item.authors || []
      if (typeof authors === 'string') {
        this['m' + n + 'Author'] = authors
      } else if (Array.isArray(authors) && authors.length > 0) {
        this['m' + n + 'Author'] = authors.join(' ')
      } else {
        this['m' + n + 'Author'] = item.author || ''
      }
      var cover = item.vertical_cover || item.square_cover || item.horizontal_cover || item.cover || '/common/images/icon_manga.png'
      this['m' + n + 'Cover'] = compressCover(cover)
    }
  },
  openItem(n) {
    var item = this.mangaList[n - 1]
    if (!item) return
    var comicId = '' + (item.id || item.comic_id || '')
    if (!comicId) {
      this.status = '缺少漫画ID'
      return
    }
    router.push({
      uri: '/mangadetail',
      params: {
        comicId: comicId,
        title: item.title || '',
        cover: cleanUrl(item.vertical_cover || item.square_cover || item.horizontal_cover || item.cover || '')
      }
    })
  },
  open1() { this.openItem(1) },
  open2() { this.openItem(2) },
  open3() { this.openItem(3) },
  open4() { this.openItem(4) },
  onInputComplete(evt) {
    var content = evt.detail.content || ''
    this.keyword = this.keyword + content
  },
  onInputDelete() {
    if (this.keyword.length > 0) {
      this.keyword = this.keyword.substring(0, this.keyword.length - 1)
    }
  },
  showKeyboard() {
    this.keyboardShow = true
  },
  doSearch() {
    var kw = this.keyword.trim()
    if (!kw) {
      this.status = '请先输入关键词'
      return
    }
    this.keyboardShow = false
    this.status = '正在搜索：' + kw
    this.trySearchProxy(kw)
  },
  trySearchProxy(kw) {
    var self = this
    this.status = '正在搜索...'
    fetch.fetch({
      url: 'https://apis.netstart.cn/bcomic/Search?key_word=' + encodeURIComponent(kw) + '&page_num=1&page_size=4',
      method: 'GET',
      header: {
        'User-Agent': 'Mozilla/5.0'
      },
      responseType: 'json',
      success: function(res) {
        var data = res.data
        if (typeof data === 'string') {
          try { data = JSON.parse(data) } catch (e) { data = null }
        }
        if (!data) {
          self.status = '搜索返回数据无效'
          return
        }
        if (data.code !== 0) {
          self.status = '搜索错误：' + (data.msg || data.message || '未知错误')
          return
        }
        var list = self.extractList(data)
        if (list && list.length > 0) {
          self.mangaList = list
          self.applyList(list)
          self.status = '找到 ' + list.length + ' 部漫画'
        } else {
          self.status = '未找到相关漫画'
        }
      },
      fail: function() {
        self.status = '搜索请求失败，请检查网络'
      }
    })
  },
  extractList(data) {
    if (!data || !data.data) return []
    var d = data.data
    var list = []
    if (d.list && Array.isArray(d.list)) {
      list = d.list
    } else if (d.result && Array.isArray(d.result)) {
      list = d.result
    } else if (d.comics && Array.isArray(d.comics)) {
      list = d.comics
    } else if (d.data && Array.isArray(d.data)) {
      list = d.data
    }
    return list
  },
  back() {
    if (this.cursorTimer) {
      clearInterval(this.cursorTimer)
      this.cursorTimer = null
    }
    router.back()
  },
  onDestroy() {
    if (this.cursorTimer) {
      clearInterval(this.cursorTimer)
      this.cursorTimer = null
    }
  }
}
</script>

<style>
.page {
  width: 336px;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  background-image: url(/common/images/bg_blue.png);
  background-size: 120%;
  background-position: center -1px;
  background-repeat: no-repeat;
  padding: 6px 8px;

}
.header {
  width: 318px;
  height: 38px;
  flex-direction: row;
  align-items: center;
}
.back {
  width: 34px;
  height: 34px;
  justify-content: center;
  align-items: center;
}
.back-text {
  color: #ffffff;
  font-size: 30px;
}
.title {
  color: #ffffff;
  font-size: 18px;
  font-weight: bold;
  margin-left: 8px;
}
.search-actions {
  width: 318px;
  height: 38px;
  margin-top: 4px;
  flex-direction: row;
  justify-content: space-between;
}
.search-btn {
  width: 152px;
  height: 36px;
  border-radius: 18px;
  background-color: #000000;
  justify-content: center;
  align-items: center;
}
.search-btn-text {
  color: #ffffff;
  font-size: 14px;
  font-weight: bold;
}
.pink {
  background-color: #fb7299;
}
.white {
  color: #ffffff;
}
.input-box {
  width: 318px;
  height: 40px;
  margin-top: 4px;
  border-radius: 12px;
  background-color: rgba(255,255,255,0.12);
  border-width: 1px;
  border-color: rgba(255,255,255,0.12);
  flex-direction: row;
  padding: 4px 8px;
  align-items: center;
}
.input-text {
  flex: 1;
  color: #ffffff;
  font-size: 16px;
  lines: 1;
  text-overflow: ellipsis;
}
.cursor {
  color: #fb7299;
  font-size: 16px;
  font-weight: bold;
}
.status {
  width: 318px;
  color: rgba(255,255,255,0.6);
  font-size: 10px;
  margin-top: 4px;
  text-align: center;
}
.list {
  width: 320px;
  flex-direction: column;
  align-items: center;
}
.manga-card {
  width: 316px;
  height: 68px;
  margin-top: 6px;
  border-radius: 14px;
  background-color: rgba(255,255,255,0.1);
  border-width: 1px;
  border-color: rgba(255,255,255,0.12);
  flex-direction: row;
  padding: 6px;
  align-items: center;
}
.manga-cover {
  width: 48px;
  height: 56px;
  border-radius: 8px;
  background-color: #fb7299;
}
.manga-info {
  flex-direction: column;
  margin-left: 10px;
  flex: 1;
  justify-content: center;
}
.manga-title {
  color: #ffffff;
  font-size: 14px;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}
.manga-author {
  color: rgba(255,255,255,0.55);
  font-size: 11px;
  margin-top: 3px;
  lines: 1;
  text-overflow: ellipsis;
}
</style>
