    this.isLoading = false
    if (this.spinTimer) {
      clearInterval(this.spinTimer)
      this.spinTimer = null
    }
  },
  switchTab(tab) {
    if (tab === 'live') {
      this.showLiveList = true
      this.showRecList = false
      this.showHotList = false
      this.tabLiveClass = 'active-text'
      this.tabRecClass = ''
      this.tabHotClass = ''
      this.tabLiveBarClass = ''
      this.tabRecBarClass = 'hide-bar'
      this.tabHotBarClass = 'hide-bar'
      this.sectionTitle = '直播推荐'
      this.loadTip = '直播中'
      if (!this.l1RoomId) {
        this.loadLiveList()
      }
    } else if (tab === 'hot') {
      this.showLiveList = false
      this.showRecList = false
      this.showHotList = true
      this.tabLiveClass = ''
      this.tabRecClass = ''
      this.tabHotClass = 'active-text'
      this.tabLiveBarClass = 'hide-bar'
      this.tabRecBarClass = 'hide-bar'
      this.tabHotBarClass = ''
      this.sectionTitle = 'B站热搜'
      this.loadTip = '点击词搜索'
      this.loadHotSearch()
    } else {
      this.showLiveList = false
      this.showRecList = true
      this.showHotList = false
      this.tabLiveClass = ''
      this.tabRecClass = 'active-text'
      this.tabHotClass = ''
      this.tabLiveBarClass = 'hide-bar'
      this.tabRecBarClass = ''
      this.tabHotBarClass = 'hide-bar'
      this.sectionTitle = '首页推荐'
      this.loadTip = this.logged ? '个性化' : '热门'
    }
  },
  formatOnline(num) {
    if (!num) return '0'
    if (num > 10000) return (num / 10000).toFixed(1) + '万'
    return '' + num
  },
  setLiveItem(index, item) {
    if (!item) return
    this['l' + index + 'Title'] = item.title || '直播间'
    this['l' + index + 'RoomId'] = item.roomid ? '' + item.roomid : ''
    this['l' + index + 'Uname'] = item.uname || '主播'
    this['l' + index + 'Online'] = this.formatOnline(item.online || 0) + '人气'
    var pic = item.cover || item.user_cover || '/common/images/icon.png'
    if (pic.indexOf('http') !== 0 && pic.indexOf('//') === 0) {
      pic = 'https:' + pic
    }
    if (pic.indexOf('hdslb.com') > 0 || pic.indexOf('biliimg.com') > 0) {
      pic = pic + '@312w_176h_1e_1c.jpg'
    }
    this['l' + index + 'Pic'] = pic
    var face = item.face || item.uface || item.user_cover || '/common/images/icon.png'
    if (face.indexOf('http') !== 0 && face.indexOf('//') === 0) {
      face = 'https:' + face
    }
    if (face.indexOf('hdslb.com') > 0 || face.indexOf('biliimg.com') > 0) {
      face = face + '@40w_40h_1e_1c.jpg'
    }
    this['l' + index + 'Face'] = face
    this['l' + index + 'Uid'] = item.uid ? '' + item.uid : ''
  },
  loadLiveList() {
    var self = this
    this.liveLoadError = false
    this.loadTip = '直播加载中...'
    var urls = [
      'https://api.live.bilibili.com/room/v2/Area/getRoomList?parent_area_id=0&area_id=0&sort_type=online&page=1&page_size=10',
      'https://api.live.bilibili.com/room/v1/Area/getRoomList?parent_area_id=0&area_id=0&sort_type=online&page=1&page_size=10',
      'https://api.live.bilibili.com/xlive/web-interface/v1/second/getList?platform=web&parent_area_id=0&area_id=0&page=1',
      'https://api.live.bilibili.com/room/v1/AppIndex/getAllList?platform=ios&device=phone'
    ]
    var urlIndex = this.liveRetryCount
    if (urlIndex >= urls.length) {
      urlIndex = urls.length - 1
    }
    var url = urls[urlIndex]
    fetch.fetch({
      url: url,
      header: { 'User-Agent': 'Mozilla/5.0 BiliApp/7.0.0', 'Referer': 'https://live.bilibili.com/' },
      responseType: 'json',
      timeout: 30000,
      success: function(res) {
        var data = res.data
        if (typeof data === 'string') { data = JSON.parse(data) }
        var list = []
        if (data && data.data && data.data.list) {
          list = data.data.list
        } else if (data && data.data && data.data.rooms) {
          list = data.data.rooms
        } else if (data && data.data && data.data.room_list) {
          list = data.data.room_list
        } else if (data && data.data && data.data.module_list) {
          var modules = data.data.module_list
          var m = 0
          for (m = 0; m < modules.length; m++) {
            if (modules[m] && modules[m].list && modules[m].list.length > 0) {
              list = list.concat(modules[m].list)
            }
          }
        } else if (data && data.data) {
          var keys = Object.keys(data.data)
          if (keys.length > 0 && data.data[keys[0]] && data.data[keys[0]].list) {
            list = data.data[keys[0]].list
          }
        }
        if (list && list.length > 0) {
          self.liveRetryCount = 0
          self.liveLoadError = false
          self.loadTip = '直播中'
          for (var i = 1; i <= 10; i++) {
            self.setLiveItem(i, list[i - 1])
          }
        } else {
          self.onLiveFail()
        }
      },
      fail: function() {
        self.onLiveFail()
      }
    })
  },
  onLiveFail() {
    this.liveRetryCount = this.liveRetryCount + 1
    if (this.liveRetryCount <= 4) {
      this.loadTip = '直播重试(' + this.liveRetryCount + ')...'
      var self = this
      setTimeout(function() {
        self.loadLiveList()
      }, 3000)
    } else {
      this.liveLoadError = true
      this.loadTip = '点击刷新'
    }
  },
  reloadLiveList() {
    if (!this.showLiveList) return
    this.liveRetryCount = 0
    this.liveLoadError = false
    for (var i = 1; i <= 10; i++) {
      this['l' + i + 'Title'] = '正在加载直播'
      this['l' + i + 'RoomId'] = ''
      this['l' + i + 'Pic'] = '/common/images/icon.png'
      this['l' + i + 'Online'] = '0'
      this['l' + i + 'Uname'] = ''
    }
    this.loadLiveList()
  },
  onTipClick() {
    if (this.showLiveList) {
      this.reloadLiveList()
    } else if (this.showHotList) {
      this.refresh()
    }
  },
  openLive(index) {
    router.push({ uri: '/live', params: { roomId: this['l' + index + 'RoomId'], title: this['l' + index + 'Title'], uname: this['l' + index + 'Uname'], pic: this['l' + index + 'Pic'] } })
  },
  openLive1() { this.openLive(1) },
  openLive2() { this.openLive(2) },
  openLive3() { this.openLive(3) },
  openLive4() { this.openLive(4) },
  openLive5() { this.openLive(5) },
  openLive6() { this.openLive(6) },
  openLive7() { this.openLive(7) },
  openLive8() { this.openLive(8) },
  openLive9() { this.openLive(9) },
  openLive10() { this.openLive(10) },
  loadUserAvatar() {
    var self = this
    storage.get({
      key: 'bili_avatar_cached',
      success: function(data) {
        if (data && data.length > 5) {
          self.userAvatar = data
        }
        self.fetchAvatarFromV2()
      },
      fail: function() {
        self.fetchAvatarFromV2()
      }
    })
  },
  fetchAvatarFromV2() {
    var self = this
    storage.get({
      key: 'bili_cookie',
      success: function(cookie) {
        if (!cookie || cookie.length < 10) {
          return
        }
        fetch.fetch({
          url: 'https://app.bilibili.com/x/v2/account/myinfo',
          header: {
            'Cookie': cookie,
            'User-Agent': 'Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.120 Mobile Safari/537.36'
          },
          responseType: 'json',
          timeout: 15000,
          success: function(res) {
            var data = res.data
            if (typeof data === 'string') {
              data = JSON.parse(data)
            }
            if (data && data.code === 0 && data.data && data.data.face) {
              var face = data.data.face
              if (face.indexOf('http') !== 0 && face.indexOf('//') === 0) {
                face = 'https:' + face
              }
              if (face.indexOf('@') > 0) {
                face = face.split('@')[0]
              }
              if (face.indexOf('hdslb.com') > 0 || face.indexOf('biliimg.com') > 0) {
                face = face + '@40w_40h_1e_1c.jpg'
              }
              self.userAvatar = face
              storage.set({ key: 'bili_avatar_cached', value: face })
            }
          },
          fail: function() {
            self.fetchAvatarFallback(cookie)
          }
        })
      },
      fail: function() {}
    })
  },
  fetchAvatarFallback(cookie) {
    var self = this
    fetch.fetch({
      url: 'https://api.bilibili.com/x/web-interface/nav',
      header: {
        'Cookie': cookie,
        'User-Agent': 'Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.120 Mobile Safari/537.36'
      },
      responseType: 'json',
      timeout: 8000,
      success: function(res) {
        var data = res.data
        if (typeof data === 'string') {
          data = JSON.parse(data)
        }
        if (data && data.data && data.data.isLogin && data.data.face) {
          var face = data.data.face
          if (face.indexOf('http') !== 0 && face.indexOf('//') === 0) {
            face = 'https:' + face
          }
          if (face.indexOf('@') > 0) {
            face = face.split('@')[0]
          }
          if (face.indexOf('hdslb.com') > 0 || face.indexOf('biliimg.com') > 0) {
            face = face + '@40w_40h_1e_1c.jpg'
          }
          self.userAvatar = face
          storage.set({ key: 'bili_avatar_cached', value: face })
        }
      },
      fail: function() {}
    })
  },
  checkLoginAndLoad() {
    var self = this
    this.showError = false
    storage.get({
      key: 'bili_cookie',
      success: function(data) {
        self.cookie = data || ''
        self.logged = self.cookie.length > 10
        storage.get({
          key: 'bili_recmode',
          success: function(mode) {
            if (mode === 'popular') {
              self.logged = false
              self.loadTip = '热门加载中'
            } else if (mode === 'personal') {
              if (!self.logged) {
                self.loadTip = '未登录，加载热门'
                self.logged = false
              } else {
                self.loadTip = '个性化加载中'
              }
            } else {
              self.loadTip = self.logged ? '个性化加载中' : '热门加载中'
            }
            self.loadPopular()
          },
          fail: function() {
            self.loadTip = self.logged ? '个性化加载中' : '热门加载中'
            self.loadPopular()
          }
        })
      },
      fail: function() {
        self.logged = false
        self.loadTip = '热门加载中'
        self.loadPopular()
      }
    })
  },
  refresh() {
    if (this.showLiveList) {
      this.loadTip = '刷新中'
      this.liveRetryCount = 0
      this.liveLoadError = false
      this.loadLiveList()
      return
    }
    if (this.showHotList) {
      this.loadTip = '刷新中...'
      this.loadHotSearch(true)
      return
    }
    this.loadTip = '刷新中'
    this.showError = false
    this.startSpinner()
    this.refreshPage = this.refreshPage + 1
    if (this.refreshPage > 5) {
      this.refreshPage = 1
    }
    this.loadPopular()
  },
  retryLoad() {
    this.showError = false
    this.loadTip = '正在重试'
    this.startSpinner()
    this.checkLoginAndLoad()
  },
  formatStat(item) {
    var view = item.stat && item.stat.view ? item.stat.view : 0
    if (view > 10000) {
      return (view / 10000).toFixed(1) + '万播放'
    }
    return view + '播放'
  },
  setItem(index, item) {
    if (!item) {
      return
    }
    this['v' + index + 'Title'] = item.title || 'B站推荐视频'
    this['v' + index + 'Stat'] = this.formatStat(item)
    this['v' + index + 'Bvid'] = item.bvid || ''
    this['v' + index + 'Cid'] = item.cid ? '' + item.cid : ''
    this['v' + index + 'Tag'] = this['v' + index + 'Stat']
    var lowPic = item.pic || '/common/images/icon.png'
    if (lowPic.indexOf('hdslb.com') > 0 || lowPic.indexOf('biliimg.com') > 0) {
      lowPic = lowPic + '@336w_210h_1e_1c.jpg'
    }
    this['v' + index + 'Pic'] = lowPic
  },
  applyList(list) {
    var i = 0
    this.sectionTitle = '首页推荐'
    this.stopPicLoader()
    this.stopFramePreloader()
    this.pendingPics = []
    for (i = 1; i <= 20; i++) {
      this.setItem(i, list[i - 1])
    }
    this.loadedCount = list.length
    if (list.length >= 3) {
      this.stopSpinner()
    }
    this.startPicLoader()
    this.buildPreloadFrames(list)
    this.startFramePreloader()
  },
  cleanImageUrl(url) {
    if (!url) {
      return ''
    }
    if (url.indexOf('http') !== 0 && url.indexOf('//') === 0) {
      url = 'https:' + url
    }
    if (url.indexOf('@') > 0) {
      url = url.split('@')[0]
    }
    return url
  },
  buildFrameUrls(pic) {
    var cover = this.cleanImageUrl(pic)
    var frames = []
    if (!cover) {
      return frames
    }
    frames.push(cover)
    if (cover.indexOf('hdslb.com') > 0 || cover.indexOf('biliimg.com') > 0) {
      frames.push(cover + '@312w_210h_1e_1c.jpg')
      frames.push(cover + '@208w_140h_1e_1c.jpg')
    }
    return frames
  },
  buildPreloadFrames(list) {
    var frames = []
    var i = 0
    var max = list.length > 4 ? 4 : list.length
    for (i = 0; i < max; i++) {
      if (list[i] && list[i].pic) {
        frames = frames.concat(this.buildFrameUrls(list[i].pic))
      }
    }
    this.preloadFrames = frames
    this.preloadIndex = 0
  },
  startFramePreloader() {
    var self = this
    if (!this.preloadFrames || this.preloadFrames.length === 0) {
      return
    }
    this.preloadFrame = this.preloadFrames[0]
    this.preloadTimer = setInterval(function() {
      self.preloadIndex = self.preloadIndex + 1
      if (self.preloadIndex >= self.preloadFrames.length) {
        self.stopFramePreloader()
        self.loadTip = self.logged ? '个性化 · 帧已预载' : '热门 · 帧已预载'
        return
      }
      self.preloadFrame = self.preloadFrames[self.preloadIndex]
    }, 300)
  },
  stopFramePreloader() {
    if (this.preloadTimer) {
      clearInterval(this.preloadTimer)
      this.preloadTimer = null
    }
  },
  startPicLoader() {
    var self = this
    this.picLoadIndex = 0
    if (this.picTimer) {
      clearInterval(this.picTimer)
    }
    this.picTimer = setInterval(function() {
      if (self.picLoadIndex >= self.pendingPics.length) {
        self.stopPicLoader()
        return
      }
      var item = self.pendingPics[self.picLoadIndex]
      self['v' + item.index + 'Pic'] = item.pic
      self.picLoadIndex = self.picLoadIndex + 1
    }, 80)
  },
  stopPicLoader() {
    if (this.picTimer) {
      clearInterval(this.picTimer)
      this.picTimer = null
    }
  },
  loadPopular() {
    var self = this
    this.showError = false
    var url = this.logged ? 'https://api.bilibili.com/x/web-interface/index/top/feed/rcmd?ps=20&fresh_type=4&fresh_idx=' + this.refreshPage : 'https://api.bilibili.com/x/web-interface/popular?ps=20&pn=' + this.refreshPage
    fetch.fetch({
      url: url,
      header: this.logged ? {
        'Cookie': this.cookie,
        'User-Agent': 'Mozilla/5.0'
      } : {
        'User-Agent': 'Mozilla/5.0'
      },
      responseType: 'json',
      timeout: 12000,
      success: function(res) {
        var data = res.data
        if (typeof data === 'string') {
          data = JSON.parse(data)
        }
        var list = []
        if (data && data.data && data.data.item) {
          list = data.data.item
        } else if (data && data.data && data.data.list) {
          list = data.data.list
        }
        if (list && list.length > 0) {
          self.applyList(list)
          self.loadTip = self.logged ? '个性化' : '热门'
          self.sectionTitle = '首页推荐'
        } else {
          if (self.logged) {
            self.logged = false
            self.loadTip = '个性化失败，切热门'
            self.loadPopular()
          } else {
            self.loadTip = '无数据'
            self.isLoading = false
            self.showError = true
            if (self.spinTimer) {
              clearInterval(self.spinTimer)
              self.spinTimer = null
            }
          }
        }
      },
      fail: function() {
        if (self.logged) {
          self.logged = false
          self.loadTip = '个性化失败，切热门'
          self.loadPopular()
        } else {
          self.loadTip = '网络失败'
          self.isLoading = false
          self.showError = true
          if (self.spinTimer) {
            clearInterval(self.spinTimer)
            self.spinTimer = null
          }
        }
      }
    })
  },
  goSearch() {
    router.push({ uri: '/search' })
  },
  goMy() {
    router.push({ uri: '/my' })
  },
  goMessages() {
    router.push({ uri: '/messages' })
  },
  loadHotSearch(force) {
    var self = this
    if (!force && this.h1Show) { return }
    if (this.hotLoading) { return }
    this.hotLoading = true
    if (!force) {
      this.loadTip = '加载中...'
    }
    fetch.fetch({
      url: 'https://api.bilibili.com/x/web-interface/search/square?limit=10',
      header: { 'User-Agent': 'Mozilla/5.0' },
      responseType: 'json',
      success: function(res) {
        self.hotLoading = false
        var data = res.data
        if (typeof data === 'string') { data = JSON.parse(data) }
        var list = []
        if (data && data.data && data.data.trending && data.data.trending.list) {
          list = data.data.trending.list
        } else if (data && data.data && data.data.list) {
          list = data.data.list
        }
        if (list && list.length > 0) {
          var max = list.length > 10 ? 10 : list.length
          var i = 0
          for (i = 0; i < max; i++) {
            var kw = list[i].keyword || list[i].show_name || list[i].name || list[i].title || ''
            self['h' + (i + 1)] = kw
            self['h' + (i + 1) + 'Show'] = true
          }
          self.loadTip = '点击词搜索'
        } else {
          self.useHotFallback()
        }
      },
      fail: function() {
        self.hotLoading = false
        self.useHotFallback()
      }
    })
  },
  useHotFallback() {
    var fallback = ['热门动画', '科技数码', '音乐现场', '游戏实况', '鬼畜', '影视剪辑', '美食', '学习', '舞蹈', '生活日常']
    var i = 0
    for (i = 0; i < 10; i++) {
      this['h' + (i + 1)] = fallback[i]
      this['h' + (i + 1) + 'Show'] = true
    }
    this.loadTip = '兜底热搜'
  },
  openHot(n) {
    var kw = this['h' + n]
    if (kw && kw.length > 0) {
      router.push({ uri: '/search', params: { keyword: kw } })
    }
  },
  openHot1() { this.openHot(1) },
  openHot2() { this.openHot(2) },
  openHot3() { this.openHot(3) },
  openHot4() { this.openHot(4) },
  openHot5() { this.openHot(5) },
  openHot6() { this.openHot(6) },
  openHot7() { this.openHot(7) },
  openHot8() { this.openHot(8) },
  openHot9() { this.openHot(9) },
  openHot10() { this.openHot(10) },
  goSettings() {
    router.push({ uri: '/settings' })
  },
  doExit() {
    router.back()
  },
  openVideo(index) {
    router.push({ uri: '/video', params: { title: this['v' + index + 'Title'], bvid: this['v' + index + 'Bvid'], cid: this['v' + index + 'Cid'], stat: this['v' + index + 'Stat'], pic: this['v' + index + 'Pic'] } })
  },
  openVideo1() {
    this.openVideo(1)
  },
  openVideo2() {
    this.openVideo(2)
  },
  openVideo3() {
    this.openVideo(3)
  },
  openVideo4() {
    this.openVideo(4)
  },
  openVideo5() {
    this.openVideo(5)
  },
  openVideo6() {
    this.openVideo(6)
  },
  openVideo7() {
    this.openVideo(7)
  },
  openVideo8() {
    this.openVideo(8)
  },
  openVideo9() {
    this.openVideo(9)
  },
  openVideo10() {
    this.openVideo(10)
  },
  openVideo11() {
    this.openVideo(11)
  },
  openVideo12() {
    this.openVideo(12)
  },
  openVideo13() {
    this.openVideo(13)
  },
  openVideo14() {
    this.openVideo(14)
  },
  openVideo15() {
    this.openVideo(15)
  },
  openVideo16() {
    this.openVideo(16)
  },
  openVideo17() {
    this.openVideo(17)
  },
  openVideo18() {
    this.openVideo(18)
  },
  openVideo19() {
    this.openVideo(19)
  },
  openVideo20() {
    this.openVideo(20)
  },
  onDestroy() {
    this.stopPicLoader()
    this.stopFramePreloader()
    this.stopSpinner()
  }
}
</script>

<style>
.page {
  width: 336px;
  flex-direction: column;
  align-items: center;
  padding: 8px;
  position: relative;
  background-color: #000000;
  background-image: url(/common/images/bg_pink.png);
  background-size: 120%;
  background-position: center -1px;
  background-repeat: no-repeat;

}
.bili-top {
  width: 320px;
  height: 58px;
  flex-direction: row;
  align-items: center;
  margin-top: 2px;
}
.bili-avatar {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.bili-avatar-img {
  width: 48px;
  height: 48px;
  border-radius: 24px;
}
.bili-login-btn {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  background-color: #fb7299;
